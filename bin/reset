#!/bin/bash
# Reset all user-mutable state from the Performance registry.
# Keeps: plugins (cache), actions (performance verbs)
# Deletes: songs, tracks, busses, effects, sends, bindings, presets
# Also removes preset files from disk.

DB="$HOME/.config/performance/registry.db"

if [ ! -f "$DB" ]; then
    echo "No registry found at $DB"
    exit 1
fi

echo "This will delete all songs, tracks, busses, effects, sends, bindings, and presets."
read -p "Continue? [y/N] " confirm
if [ "$confirm" != "y" ] && [ "$confirm" != "Y" ]; then
    echo "Aborted."
    exit 0
fi

sqlite3 "$DB" <<'SQL'
DELETE FROM bindings;
DELETE FROM sends;
DELETE FROM effects;
DELETE FROM tracks;
DELETE FROM busses;
DELETE FROM presets;
DELETE FROM songs;
SQL

# Remove preset files
rm -rf "$HOME/.config/performance/snapshots/"*

echo "Done. Registry reset. Restart the app to get a fresh Sandbox."
