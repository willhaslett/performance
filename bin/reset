#!/bin/bash
# Full reset — simulates a first-ever launch.
# Removes ALL user state, caches, recordings, presets, and databases.
# Preserves only ~/.config/performance/keys/ (notarization credentials).
#
# The app recreates everything it needs on next launch:
# - state.db (fresh schema)
# - plugin-cache.xml (re-scans AU plugins, takes a few seconds)
# - themes/ (factory themes baked into binary)
# - Default "Untitled" song with DLS Electric Piano + Audio In

set -euo pipefail

CONFIG_DIR="$HOME/.config/performance"

if [ ! -d "$CONFIG_DIR" ]; then
    echo "Nothing to reset — $CONFIG_DIR doesn't exist."
    exit 0
fi

echo "Resetting $CONFIG_DIR (preserving keys/)..."

# Preserve keys/ (notarization credentials) and plugin-cache.xml
# (AU scan results — re-scanning from scratch can hang on bad plugins).
PRESERVE_TMP=$(mktemp -d)
[ -d "$CONFIG_DIR/keys" ] && cp -r "$CONFIG_DIR/keys" "$PRESERVE_TMP/"
[ -f "$CONFIG_DIR/plugin-cache.xml" ] && cp "$CONFIG_DIR/plugin-cache.xml" "$PRESERVE_TMP/"

# Nuke everything
rm -rf "$CONFIG_DIR"

# Restore preserved items
mkdir -p "$CONFIG_DIR"
[ -d "$PRESERVE_TMP/keys" ] && mv "$PRESERVE_TMP/keys" "$CONFIG_DIR/"
[ -f "$PRESERVE_TMP/plugin-cache.xml" ] && mv "$PRESERVE_TMP/plugin-cache.xml" "$CONFIG_DIR/"
rm -rf "$PRESERVE_TMP"

echo "Done. Restart the app for a fresh first-launch experience."
