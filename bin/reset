#!/bin/bash
# Reset all user-mutable state from the Performance database.
# Keeps: plugins (cache), actions (built-in)
# Deletes: everything else including device mappings
# Also removes preset files from disk.

STATE_DB="$HOME/.config/performance/state.db"

if [ ! -f "$STATE_DB" ]; then
    echo "No database found at $STATE_DB"
    exit 0
fi

echo "Resetting $STATE_DB..."

sqlite3 "$STATE_DB" <<'SQL'
DELETE FROM bindings;
DELETE FROM sends;
DELETE FROM effects;
DELETE FROM tracks;
DELETE FROM busses;
DELETE FROM presets;
DELETE FROM song_devices;
DELETE FROM songs;
DELETE FROM config;
-- Device mappings (comment out to preserve across resets)
DELETE FROM device_controls;
DELETE FROM devices;
-- Remove custom actions but keep built-ins (no lua_code)
DELETE FROM actions WHERE lua_code IS NOT NULL AND lua_code != '';
SQL

# Remove preset files from disk
rm -rf "$HOME/.config/performance/snapshots/"*
rm -rf "$HOME/.config/performance/track_presets/"*

echo "Done. Restart the app to get a fresh Sandbox."
