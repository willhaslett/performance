#!/bin/bash
# Reset all user-mutable state from the Performance registry.
# Keeps: plugins (cache), actions (performance verbs)
# Deletes: songs, tracks, busses, effects, sends, bindings, presets
# Also removes preset files from disk.

# Support both old (registry.db) and new (state.db) databases
STATE_DB="$HOME/.config/performance/state.db"
LEGACY_DB="$HOME/.config/performance/registry.db"

reset_db() {
    local db="$1"
    if [ ! -f "$db" ]; then return; fi
    echo "Resetting $db..."
    sqlite3 "$db" <<'SQL'
DELETE FROM bindings;
DELETE FROM sends;
DELETE FROM effects;
DELETE FROM tracks;
DELETE FROM busses;
DELETE FROM presets;
DELETE FROM songs;
DELETE FROM config;
SQL
    # Handle new schema tables (may not exist in old DB)
    sqlite3 "$db" "DELETE FROM score_steps;" 2>/dev/null
}

reset_db "$STATE_DB"
reset_db "$LEGACY_DB"

# Remove preset files from disk
rm -rf "$HOME/.config/performance/snapshots/"*
rm -rf "$HOME/.config/performance/track_presets/"*

echo "Done. Registry reset. Restart the app to get a fresh Sandbox."
