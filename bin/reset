#!/bin/bash
# Full reset — simulates a first-ever launch with a clean DB.
# Wipes user state, caches, recordings, presets, and the entire
# state.db file. Preserves only:
#   - ~/.config/performance/keys/             (notarization + telemetry config)
#   - ~/.config/performance/plugin-cache.xml  (AU scan results — re-scan can hang on bad plugins)
#
# The app recreates everything else on next launch:
# - state.db with the current code's schema (no migration / version drift)
# - default "Untitled" song with DLS Piano + Audio In
# - plugin catalog (re-populated from plugin-cache.xml)
# - actions, presets, config rows
#
# Pre-beta convention: no DB migration code (CLAUDE.md). If the on-disk
# schema doesn't match the current code, this script is the answer.
# MIDI device mappings get wiped along with everything else; re-pair
# from Settings > MIDI on next launch.

set -euo pipefail

CONFIG_DIR="$HOME/.config/performance"

if [ ! -d "$CONFIG_DIR" ]; then
    echo "Nothing to reset — $CONFIG_DIR doesn't exist."
    exit 0
fi

echo "Resetting $CONFIG_DIR (preserving keys/, plugin-cache.xml)..."

# Filesystem wipe — everything except the preserved entries above.
# Includes state.db, state.bak.db, presets/, track_presets/, themes/,
# any audio recording dirs, etc.
find "$CONFIG_DIR" -mindepth 1 -maxdepth 1 \
    ! -name keys \
    ! -name plugin-cache.xml \
    -exec rm -rf {} +

echo "Done. Restart the app for a fresh first-launch experience."
